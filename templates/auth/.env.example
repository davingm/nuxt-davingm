# ─── App ──────────────────────────────────────────────────────────────────────
API_BASE=http://localhost:3000/api
NAME_APP="Nuxt-app"
ENABLE_DEVTOOLS=true

# ─── Database ─────────────────────────────────────────────────────────────────
# Driver: hanya "sqlite" yang didukung (default)
DB_CONNECTION=sqlite

# Path file SQLite (relatif dari root project)
DB_DATABASE=.data/database.sqlite

# Behavior saat server start:
#   update      → buat tabel jika belum ada, data tetap aman (default, cocok untuk production)
#   create-drop → drop & buat ulang semua tabel setiap start (cocok untuk development/testing)
DB_TYPE=update

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Ganti dengan string acak yang panjang di production!
JWT_SECRET=supersecretkey_change_me_in_production
